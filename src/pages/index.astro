
---
import { client, urlFor } from '../lib/sanity'

const posts = await client.fetch(`
  *[_type == "post" && defined(slug.current)] | order(publishedAt desc)[0...3] {
    _id,
    title,
    slug,
    excerpt,
    category,
    coverImage
  }
`)
---

<html lang="en">
  
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>GifyTech Journal | AI Automation, Websites & Digital Growth</title>

    <meta
      name="description"
      content="Discover practical guides on AI automation, website development, digital marketing, and business growth from GifyTech."
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.site?.href || 'https://gifytech-blog.vercel.app/'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GifyTech Journal" />
    <meta
      property="og:title"
      content="GifyTech Journal | AI Automation, Websites & Digital Growth"
    />
    <meta
      property="og:description"
      content="Practical guides on AI automation, website development, digital marketing, and business growth."
    />
    <meta property="og:url" content={Astro.site?.href || 'https://gifytech-blog.vercel.app/'} />

    <meta name="twitter:card" content="summary" />
  </head>


  <body>
    <header>
      <a class="logo" href="/">Gify<span>Tech</span> Journal</a>
      <nav>
        <a class="active" href="/">Home</a>
        <a href="/blog/">Articles</a>
        <a href="https://gifytech-website-bay.vercel.app/">GifyTech Agency ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">THE GIFYTECH JOURNAL</p>
        <h1>Ideas that help your <span>business grow.</span></h1>
        <p>
          Practical insights on AI automation, websites, digital marketing,
          and building a stronger online presence.
        </p>
        <a class="cta" href="/blog/">Explore Articles →</a>
      </section>

      <section class="articles">
        <p class="eyebrow">KNOWLEDGE THAT MOVES BUSINESS FORWARD</p>
        <h2>Latest Articles</h2>
        <div class="grid">
          {posts.map((post) => (
            <a class="card" href={`/blog/${post.slug.current}/`}>
              {post.coverImage && (
                <img
                  src={urlFor(post.coverImage)}
                  alt={post.coverImage.alt || post.title}
                  loading="lazy"
                />
              )}
              <div class="card-content">
                <span class="category">
                  {post.category?.replaceAll('-', ' ')}
                </span>
                <h3>{post.title}</h3>
                <p>{post.excerpt}</p>
                <span class="read-more">Read Article →</span>
              </div>
            </a>
          ))}
        </div>
        <a class="all-articles" href="/blog/">View All Articles →</a>
      </section>
    </main>

    <footer>
      © {new Date().getFullYear()} GifyTech Journal.
      <a href="https://gifytech-website-bay.vercel.app/">Visit GifyTech Agency</a>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    font-family: Arial, sans-serif;
    color: #202338;
    background: #fff;
  }
  :global(a) { text-decoration: none; color: inherit; }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 7%;
    border-bottom: 1px solid #eae8f2;
  }
  .logo { font-size: 23px; font-weight: 800; white-space: nowrap; }
  .logo span, h1 span { color: #7355d8; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; font-size: 14px; font-weight: 700; }
  nav a:hover, .active { color: #7355d8; }
  .hero {
    padding: 100px 7%;
    text-align: center;
    background: linear-gradient(135deg, #f1edff, #fff 75%);
  }
  .eyebrow { color: #7355d8; font-size: 12px; font-weight: 800; letter-spacing: 2px; }
  h1 { max-width: 850px; margin: 22px auto; font-size: clamp(40px, 7vw, 72px); line-height: 1.08; letter-spacing: -2px; }
  .hero > p:not(.eyebrow) { max-width: 650px; margin: 0 auto 30px; color: #697087; font-size: 18px; line-height: 1.8; }
  .cta { display: inline-block; padding: 15px 23px; border-radius: 8px; color: white; background: #7355d8; font-weight: 700; }
  .articles { max-width: 1300px; margin: auto; padding: 75px 7%; }
  h2 { margin: 12px 0 30px; font-size: 34px; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 25px; }
  .card { overflow: hidden; border: 1px solid #eae8f2; border-radius: 16px; transition: transform .2s, box-shadow .2s; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 15px 35px #20233814; }
  .card img { display: block; width: 100%; height: 220px; object-fit: cover; }
  .card-content { padding: 24px; }
  .category { color: #7355d8; font-size: 12px; font-weight: 800; text-transform: capitalize; }
  h3 { font-size: 21px; line-height: 1.4; }
  .card p { color: #697087; line-height: 1.7; }
  .read-more, .all-articles { color: #7355d8; font-weight: 700; }
  .all-articles { display: inline-block; margin-top: 30px; }
  footer { padding: 30px 7%; border-top: 1px solid #eae8f2; text-align: center; color: #697087; }
  footer a { color: #7355d8; }
  @media(max-width: 800px) {
    header { align-items: flex-start; flex-direction: column; padding: 22px 5%; }
    nav { gap: 16px; }
    .hero { padding: 75px 5%; }
    .articles { padding: 55px 5%; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media(max-width: 550px) {
    .grid { grid-template-columns: 1fr; }
    h1 { letter-spacing: -1px; }
  }
</style>
